{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Dashboard Search Metadata",
  "id": "andygrunwald-dashboardsearchmetadatademo-app",
  "info": {
    "keywords": ["app"],
    "description": "Demo: shows dashboard metadata such as tags and the owning team in Grafana's search",
    "author": {
      "name": "Andy Grunwald"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "preload": true,
  "extensions": {
    "addedComponents": [
      {
        "targets": ["grafana/commandpalette/result-item/v1"],
        "title": "Dashboard search metadata",
        "description": "Shows dashboard tags and the owning team on dashboard rows in Grafana's search"
      }
    ]
  },
  "dependencies": {
    "grafanaDependency": ">=13.3.0-0",
    "plugins": []
  }
}
